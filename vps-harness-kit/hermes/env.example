# ============================================================================
# TÊN BIẾN MÔI TRƯỜNG — KHÔNG chứa key thật.
# .env của Hermes CHỈ chứa secret (API key, token, password). Mọi cấu hình
# hành vi khác đặt trong config.yaml.
#
# File thật: ~/.hermes/.env  hoặc  ~/.hermes/profiles/<profile>/.env
# Xem đường dẫn đang dùng: `hermes config env-path`
# Không commit file .env. Không in nội dung ra chat/log.
# ============================================================================

# Key cho LLM Qwen 3.6 nội bộ FOXAI (profile foxai-qwen).
# Lấy key từ đội hạ tầng FOXAI, dán vào đây trên VPS:
HERMES_CUSTOM_FOXAI_QWEN_API_KEY=<dat-key-that-o-day-tren-vps>

# Nếu bật gateway loopback cho profile foxai-qwen, Hermes sẽ tự sinh:
# API_SERVER_KEY=<hermes-tu-sinh>
# API_SERVER_PORT=8642
